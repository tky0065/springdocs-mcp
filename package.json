{
  "name": "@enokdev/springdocs-mcp",
  "version": "1.2.5",
  "description": "Enhanced MCP server for accessing Spring Boot documentation with advanced features, intelligent caching, and comprehensive ecosystem coverage",
  "type": "module",
  "main": "build/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tky0065/springdocs-mcp.git"
  },
  "homepage": "https://github.com/tky0065/springdocs-mcp#readme",
  "bugs": {
    "url": "https://github.com/tky0065/springdocs-mcp/issues"
  },
  "bin": {
    "springdocs-mcp": "build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "npm run build && node build/index.js",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "bash test.sh",
    "test-npx": "./test-npx.sh",
    "install-global": "npm install -g .",
    "version:patch": "npm version patch && git push origin main --follow-tags",
    "version:minor": "npm version minor && git push origin main --follow-tags",
    "version:major": "npm version major && git push origin main --follow-tags",
    "release:dry": "npm publish --dry-run",
    "release:manual": "npm run build && npm publish",
    "release:check": "npm view @enokdev/springdocs-mcp version",
    "cicd:setup": "./setup-cicd.sh",
    "cicd:check": "./check-cicd.sh"
  },
  "keywords": [
    "mcp",
    "spring-boot",
    "spring-framework",
    "documentation",
    "model-context-protocol",
    "spring-ecosystem",
    "claude",
    "ai-assistant",
    "java",
    "spring-docs",
    "caching",
    "tutorials",
    "best-practices",
    "diagnostics",
    "version-comparison",
    "ecosystem-search"
  ],
  "author": "EnokDev <enokdev@example.com> (https://github.com/tky0065)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^3.3.2",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.0",
    "typescript": "^5.3.0"
  }
}
